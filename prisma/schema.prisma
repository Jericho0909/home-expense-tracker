generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Utilities

model UtilityExpense {
  id            String        @id @default(uuid())
  name          String
  expense       Expenses
  amount        Float
  status        Status
  billingStart  DateTime?
  billingEnd    DateTime?
  dueDate       DateTime?
  paymentMethod PaymentMethod?
  notes         String
  createdAt     DateTime      @default(now())
}

// Food & Household

model FoodHouseholdExpense {
  id            String        @id @default(uuid())
  name          String
  expense       Expenses
  type          FoodHouseholdType
  category      FoodHouseholdCategory
  amount        Float
  status        Status
  purchaseDate  DateTime?
  paymentMethod PaymentMethod?
  notes         String
  createdAt     DateTime      @default(now())
}

// Transportation

model TransportationExpense {
  id            String        @id @default(uuid())
  description   String
  expense       Expenses
  category      TransportationCategory
  amount        Float
  date          DateTime
  paymentMethod PaymentMethod
  notes         String
  createdAt     DateTime      @default(now())
}

// Health

model HealthExpense {
  id            String        @id @default(uuid())
  description   String
  expense       Expenses
  category      HealthCategory
  amount        Float
  date          DateTime
  paymentMethod PaymentMethod
  notes         String
  createdAt     DateTime      @default(now())
}

// House Maintenanc

model HouseMaintenanceExpense {
  id            String        @id @default(uuid())
  description   String
  expense       Expenses
  category      HouseMaintenanceCategory
  amount        Float
  date          DateTime
  paymentMethod PaymentMethod
  notes         String
  createdAt     DateTime      @default(now())
}


// Family Expenses

model FamilyExpense {
  id            String        @id @default(uuid())
  description   String
  expense       Expenses
  category      FamilyExpenseCategory
  amount        Float
  date          DateTime
  paymentMethod PaymentMethod
  notes         String
  createdAt     DateTime      @default(now())
}


// Other Expenses

model OtherExpense {
  id            String        @id @default(uuid())
  description   String
  expense       Expenses
  category      OtherExpenseCategory
  amount        Float
  date          DateTime
  paymentMethod PaymentMethod
  notes         String
  createdAt     DateTime      @default(now())
}

// Family Member

model FamilyMember {
  id            String        @id @default(uuid())
  name          String
  familyRole    FamilyRole
  money         Float
  createdAt     DateTime      @default(now())

}

// Enum

enum Expenses {
  Utilities
  FoodAndHousehold
  Transportation
  Health
  HouseMaintenance
  FamilyExpenses
  OtherExpenses
  BudgetSetting
}

enum UtilityCategory {
  Electricity
  Water
  Internet
  MobileLoad
  MineralWater
}

enum FoodHouseholdType {
  Food
  Household
}

enum FoodHouseholdCategory {
  Groceries
  Meat
  Seafood
  Fruits
  Vegetables
  Snacks
  Beverages
  Cleaning
  Laundry
  PersonalCare
  Kitchen
  HomeSupplies
}

enum TransportationCategory {
  Fuel
  PublicTransport
  RideHailing
  Parking
  Toll
  VehicleMaintenance
}

enum HealthCategory {
  Medicine
  Consultation
  Dental
  Laboratory
  Other
}

enum HouseMaintenanceCategory {
  Repairs
  Maintenance
  Cleaning
  PestControl
  Other
}

enum FamilyExpenseCategory {
  Education
  Allowance
  Entertainment
  Celebrations
  Other
}

enum OtherExpenseCategory {
  Personal
  Donations
  Subscriptions
  Government
  Miscellaneous
  Tickets
  Fees
  Services
}

enum FamilyRole{
  Father
  Mother
  Son
  Daughter
  Grandfather
  Grandmother
  Uncle
  Aunt
  Other
}

enum Status {
  Paid
  Pending
  Overdue
  Unpaid
}

enum PaymentMethod {
  Cash
  GCash
  BankTransfer
  Maya
  Other
}